{
  "name": "dsh-gasteam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable Agent Teams plugin for DeepSeek Harness",
  "license": "MIT",
  "repository": "github:Silktex/dsh-gasteam",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:distribution": "node scripts/build-dsh-team-distribution.mjs",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "vitest run",
    "check:docs": "node scripts/check-docs.mjs",
    "dsh": "dsh",
    "install:profile": "node scripts/install-profile.mjs",
    "start": "dsh --profile web --no-open",
    "demo:dashboard": "node scripts/dashboard-demo.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:release": "node scripts/standalone-release-validation.mjs",
    "test:distribution": "node scripts/test-dsh-team-distribution.mjs",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-subagent-control": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "execa": "^10.0.1",
    "js-yaml": "^4.3.2",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3",
    "lightningcss": "^1.33.0",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1"
  }
}
