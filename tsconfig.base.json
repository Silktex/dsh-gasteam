{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@deepseek-ai/dsh-experimental-tool-agent-team": [
        "./packages/tool-agent-team/src/index.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team": [
        "./packages/agent-team/src/index.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team-profile": [
        "./packages/agent-team-profile/src/index.ts"
      ],
      "@deepseek-ai/dsh-experimental-client-ui-agent-team": [
        "./packages/client-ui-agent-team/src/index.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team-web-profile": [
        "./packages/agent-team-web-profile/src/index.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team/client": [
        "./packages/agent-team/src/client.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team/types": [
        "./packages/agent-team/src/types.ts"
      ],
      "@deepseek-ai/dsh-experimental-agent-team/remote": [
        "./packages/agent-team/src/remote.ts"
      ]
    }
  }
}
